# Per-project Docker orchestration config for a Next.js frontend. Copy to deploy/.docker-env.
# NEXT_PUBLIC_* values are browser-visible and are compiled into production images at build time.

STACK=next
NODE_VERSION=20
IMAGE_NAME=app
IMAGE_TAG=latest

# Host-published development server and loopback-only production server ports.
VITE_PORT=3000
APP_HTTP_PORT=3000

# Public API origin the browser calls. Use the reverse-proxied API URL in production, not an
# internal Docker hostname.
NEXT_PUBLIC_API_URL=

APP_CONTAINER=app-web
